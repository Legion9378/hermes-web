#!/usr/bin/env bash
set -euo pipefail
APP_DIR="${HERMES_WEB_DIR:-$HOME/hermes-web}"
HOST="${HERMES_WEB_HOST:-127.0.0.1}"
PORT="${HERMES_WEB_PORT:-4173}"
HERMES_API="${HERMES_WEB_API:-http://127.0.0.1:8642}"
BASE_PATH="${HERMES_WEB_BASE_PATH:-}"
cd "$APP_DIR"
exec python3 serve.py --host "$HOST" --port "$PORT" --hermes-api "$HERMES_API" --base-path "$BASE_PATH"
